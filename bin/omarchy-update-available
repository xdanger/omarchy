#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.

set -euo pipefail

updates=()

if [[ $OMARCHY_PATH != "/usr/share/omarchy" ]]; then
  upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$OMARCHY_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$OMARCHY_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("omarchy-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

package=""
if pacman -Qq omarchy-dev >/dev/null 2>&1; then
  package=omarchy-dev
elif pacman -Qq omarchy >/dev/null 2>&1; then
  package=omarchy
fi

# checkupdates exits 0 with updates, 2 with none, and 1 when it could not
# check, offline say.
pending=()
pending_status=0
pending_output=$(checkupdates --nocolor 2>/dev/null) || pending_status=$?
[[ -z $pending_output ]] || mapfile -t pending <<<"$pending_output"

# Until the first omarchy update, any package counts: a machine installed from
# older media needs one even when Omarchy's own package is current.
if ! omarchy-done check first-update; then
  updates+=("${pending[@]}")
elif [[ -n $package ]]; then
  for line in "${pending[@]}"; do
    if [[ ${line%% *} == "$package" ]]; then
      updates+=("$line")
      break
    fi
  done
fi

# After that, other packages count only when their update fixes a known
# security issue. A check that could not reach the repositories leaves the
# last findings alone instead of reading as none.
if (( pending_status == 0 || pending_status == 2 )); then
  mapfile -t security < <(printf '%s\n' "${pending[@]}" | omarchy-update-security scan 2>/dev/null || true)
  updates+=("${security[@]}")
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Omarchy is up to date"
  exit 1
fi
